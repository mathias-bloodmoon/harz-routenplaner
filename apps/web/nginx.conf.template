# Rendered by the nginx image at start (envsubst): ${STAMPS_ENABLED} is replaced, nginx variables are kept.
# Stamp layer gate (CONCEPT.md §3): only the literal value "true" enables it.
map "${STAMPS_ENABLED}" $stamps_enabled {
    default "false";
    "true"  "true";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # No access log: routes and IPs are not stored (privacy, see CONCEPT.md §5).
    access_log off;

    # Password protection (basic auth) when BASIC_AUTH=true, written by /docker-entrypoint.d/41-basic-auth.sh
    include /tmp/runtime/auth.conf;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.tile.opentopomap.org https://tile.waymarkedtrails.org; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'" always;

    location = /healthz {
        auth_basic off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Runtime configuration for the frontend, written at start by /docker-entrypoint.d/40-runtime-config.sh
    location = /config.json {
        default_type application/json;
        expires -1;
        alias /tmp/runtime/config.json;
    }

    # Stamp data is mounted at /srv/data (not baked into the public image, see data/README.md)
    location = /data/stamps.geojson {
        if ($stamps_enabled != "true") {
            return 404;
        }
        default_type application/geo+json;
        alias /srv/data/stamps.geojson;
    }

    location /api/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $api_upstream http://harz-api:3000;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # /impressum, /datenschutz, /datenquellen → the static pages
    location / {
        try_files $uri $uri.html /index.html;
    }
}
