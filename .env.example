# Copy to infra/.env (docker compose) or export in your shell. All values are optional.

# Port the local stack is published on (docker compose, local dev only; production publishes no ports).
WEB_PORT=80

# api: port and log level inside the container
API_PORT=3000
LOG_LEVEL=info

# Stamp layer (Harzer Wandernadel). Local default true; production false until written permission.
STAMPS_ENABLED=true
# Folder with stamps.geojson, mounted into the web container (docker compose). Relative to infra/.
STAMPS_DATA_DIR=../data
# vite dev/preview only: path of the stamp file (default data/stamps.geojson)
# STAMPS_FILE=../../data/stamps.geojson

# Routing (api + BRouter), see infra/README.md
RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY_HOPS=1
# Folder with the BRouter segments (*.rd5), relative to infra/
SEGMENTS_DIR=../data/segments
