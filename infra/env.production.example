# /opt/harz-routenplaner/.env – settings of the production stack. Created once by the deploy, never overwritten:
# edit it on the server, then run: docker compose up -d
# Image version, set by every deploy (rollback: put an older value here, see infra/README.md)
HARZ_TAG=latest
# Stamp layer: "true" only by decision of Mathias (CLAUDE.md, CONCEPT.md §3)
STAMPS_ENABLED=false
# Impressum / privacy page. Address lines separated by "|", e.g. "Musterweg 1|37120 Bovenden"
OPERATOR_NAME=Mathias Nagel
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
# Password protection of the whole site (user/password: GitHub secret SITE_BASIC_AUTH). "false" makes it public.
BASIC_AUTH=true
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=warn
